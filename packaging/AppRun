#!/bin/sh
# AppRun - entry point for the proton-launcher AppImage.
#
# AppImages are mounted read-only, so anything that must be written goes to a
# per-user directory under XDG_DATA_HOME. The launcher keeps its config and
# prefixes there by default; this only redirects the config location when the
# AppImage is run as a different user or with a sandboxed HOME.
set -eu

HERE="$(dirname "$(readlink -f "$0")")"

if [ -z "${XDG_DATA_HOME:-}" ]; then
    export XDG_DATA_HOME="${HOME}/.local/share"
fi
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"

# AppImage launcher libraries must not be confused with the system's.
export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH:-}"

# The loaders cache was written at build time with a placeholder where this
# script's own directory goes, since the mount point is only known now.
LOADER_CACHE_TEMPLATE="${HERE}/usr/lib/proton-launcher/gdk-pixbuf/loaders.cache"
if [ -f "$LOADER_CACHE_TEMPLATE" ]; then
    CACHE_FILE="${XDG_CACHE_HOME}/proton-launcher/loaders.cache"

    mkdir -p "${XDG_CACHE_HOME}/proton-launcher"
    sed "s|@@APPDIR@@|$HERE|g" "$LOADER_CACHE_TEMPLATE" > "$CACHE_FILE"

    export GDK_PIXBUF_MODULE_FILE="$CACHE_FILE"
fi

exec "${HERE}/usr/bin/proton-launcher" "$@"